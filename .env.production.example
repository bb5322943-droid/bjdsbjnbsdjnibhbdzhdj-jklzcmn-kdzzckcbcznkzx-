# ==========================================
# FUSION ERP - PRODUCTION ENVIRONMENT
# ==========================================
# ⚠️  DIQQAT: Bu faylni .env.production nomi bilan copy qiling
# va qiymatlarni o'z production qiymatlaringizga o'zgartiring!
# ==========================================

# Environment
NODE_ENV=production

# Database - PostgreSQL (Production)
# Render/Railway/Vercel PostgreSQL URL'ni bu yerga qo'ying
DATABASE_URL=postgresql://username:password@host:5432/database_name

# JWT Secrets (MAJBURIY: Yangi qiymatlar!)
# Bu yerda namuna qiymatlar - O'ZINGIZNI yarating!
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=8065f7e15a2c3f45066dfa6fd74dde6e3586c94996d078509d4bca75a13849e2
JWT_REFRESH_SECRET=07cf1169d3b0f8a4c87a2295c8e7c2c589d24f03b2c75011522c662de6f6b09f
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin Account (MAJBURIY: O'zgartiring!)
# KUCHLI parol ishlating: kamida 12 belgi, katta/kichik harf, raqam, maxsus belgi
ADMIN_EMAIL=admin@yourcompany.uz
ADMIN_PASSWORD=YourSuperStrong!P@ssw0rd2024

# CORS - Production domain'laringizni qo'shing
# Masalan: https://your-app.vercel.app yoki https://yourdomain.com
ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com

# Rate Limiting (DDoS protection)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/fusion-erp.log

# Email (Agar email xizmati kerak bo'lsa)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional
PING_MESSAGE="pong"
