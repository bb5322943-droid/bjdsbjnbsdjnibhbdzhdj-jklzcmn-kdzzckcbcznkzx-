    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.15.4",
    "serverless-http": "^3.2.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.176.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "pkg": {
    "assets": [
      "dist/spa/*"
    ],
    "scripts": [
      "dist/server/**/*.js"
    ]
  },
  "allowScripts": {
    "file:../esbuild@0.25.8/node_modules/esbuild": true,
    "file:../../esbuild@0.25.8/node_modules/esbuild": true
  }
}
