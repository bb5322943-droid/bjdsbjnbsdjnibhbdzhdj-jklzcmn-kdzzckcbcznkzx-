{
  "name": "fusion-erp",
  "version": "1.0.1",
  "description": "Full-featured ERP system for small and medium businesses",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "better-sqlite3"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config vite.config.server.ts",
    "build:vercel": "vite build && vite build --config vite.config.vercel.ts",
    "start": "node dist/server/node-build.mjs",
    "test": "vitest --run",
    "format.fix": "prettier --write .",
    "typecheck": "tsc",
    "backup": "node -e \"require('./dist/server/lib/backup').createBackup()\"",
    "backup:clean": "node -e \"require('./dist/server/lib/backup').cleanOldBackups()\"",
    "check:security": "echo 'Checking security vulnerabilities...' && npm audit --audit-level=moderate",
    "check:env": "node -e \"const fs=require('fs');const env=fs.readFileSync('.env','utf8');if(env.includes('default-secret')||env.includes('Orbis2026')){console.error('❌ .env faylida standart parollar/secretlar topildi!');process.exit(1)}else{console.log('✅ .env fayli xavfsiz')}\""
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "node-schedule": "^2.1.1",
    "pg": "^8.23.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@swc/core": "^1.16.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
