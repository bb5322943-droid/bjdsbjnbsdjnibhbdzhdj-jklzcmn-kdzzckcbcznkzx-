# ==============================================
# FUSION ERP - ENVIRONMENT CONFIGURATION
# ==============================================
# Production uchun bu faylni .env ga nusxalang va
# haqiqiy qiymatlarni kiriting!

# ---------------------------------------------
# SERVER CONFIGURATION
# ---------------------------------------------
NODE_ENV=production
PORT=8081

# ---------------------------------------------
# DATABASE (PostgreSQL - Production)
# ---------------------------------------------
# PostgreSQL connection string
# Vercel Postgres: https://vercel.com/dashboard → Storage → Postgres
# Supabase: https://app.supabase.com → Settings → Database
# Neon: https://console.neon.tech → Connection String
DATABASE_URL=postgresql://username:password@host:5432/database_name

# SQLite path (development only - PostgreSQL production uchun tavsiya etiladi)
DATABASE_PATH=./data/app.db

# Automatic database backup (cron format)
# Default: Har kun soat 02:00
BACKUP_SCHEDULE=0 2 * * *

# Backup retention (kunlarda)
BACKUP_RETENTION_DAYS=30

# ---------------------------------------------
# AUTHENTICATION & SECURITY
# ---------------------------------------------
# JWT secrets - MUHIM: Production'da MAJBURIY o'zgartiring!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-64-chars-minimum
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-64-chars-minimum

# JWT token expiration
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d

# Admin default credentials
# DIQQAT: Production deploy qilishdan OLDIN o'zgartiring!
ADMIN_EMAIL=admin@orbiserp.uz
ADMIN_PASSWORD=OrbisAdmin2024!

# ---------------------------------------------
# API RATE LIMITING
# ---------------------------------------------
# Rate limit window (milliseconds) - 15 daqiqa
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------
# CORS CONFIGURATION
# ---------------------------------------------
# Allowed origins (comma separated)
# Production'da faqat ishonchli domenlarni kiriting
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,https://your-domain.vercel.app

# ---------------------------------------------
# LOGGING & MONITORING
# ---------------------------------------------
# Log level: error | warn | info | debug
LOG_LEVEL=info

# Sentry DSN (optional - error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ---------------------------------------------
# FILE STORAGE (Optional)
# ---------------------------------------------
# AWS S3 (for file uploads and backups)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# Cloudinary (alternative to S3)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ---------------------------------------------
# EMAIL SERVICE (Optional)
# ---------------------------------------------
# SendGrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@orbiserp.uz

# Mailgun
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=mg.orbiserp.uz

# ---------------------------------------------
# REDIS (Optional - for caching)
# ---------------------------------------------
# REDIS_URL=redis://username:password@host:6379

# ---------------------------------------------
# FEATURE FLAGS
# ---------------------------------------------
# Enable/disable features
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_AUTOMATIC_BACKUPS=true
ENABLE_AUDIT_LOGGING=true

# ---------------------------------------------
# DEVELOPMENT ONLY
# ---------------------------------------------
# Ping message (for testing)
PING_MESSAGE=pong

# ==============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ==============================================
# [ ] JWT_SECRET va JWT_REFRESH_SECRET o'zgartirildi (64+ chars)
# [ ] ADMIN_PASSWORD kuchli parolga o'zgartirildi
# [ ] DATABASE_URL to'g'ri PostgreSQL connection stringga o'rnatildi
# [ ] ALLOWED_ORIGINS faqat ishonchli domenlarni o'z ichiga oladi
# [ ] LOG_LEVEL="error" yoki "warn" (production uchun)
# [ ] Barcha optional xizmatlar sozlandi (Sentry, S3, Email)
# [ ] Environment variables Vercel dashboard'ga qo'shildi
# [ ] Database backup tizimi tekshirildi
# [ ] SSL sertifikat o'rnatildi (Vercel avtomatik beradi)
# [ ] Rate limiting test qilindi
# [ ] Load testing o'tkazildi
# [ ] Security scan qilindi
