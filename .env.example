# Environment muhiti (development, production, staging)
NODE_ENV=development

# Database (Production uchun PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
DATABASE_PATH=./data/app.db

# JWT va xavfsizlik (O'ZGARTIRING!)
# ⚠️ MAJBURIY: Production'da bu qiymatlarni albatta o'zgartiring!
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-change-this-min-32-chars
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d

# Admin foydalanuvchi (birinchi o'rnatish uchun)
# ⚠️ MAJBURIY: Kamida 8 belgi, katta/kichik harf, raqam va maxsus belgi (!@#$%^&*)
# Misol: Admin123!Fusion
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# CORS sozlamalari (vergul bilan ajrating)
# Development uchun: localhost:5173, localhost:8080, localhost:8081
# Production uchun: o'z domeningizni qo'shing
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Backup sozlamalari
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Email (keyinchalik)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Builder.io (agar kerak bo'lsa)
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
